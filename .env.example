# Copy to .env and fill in. Real environment variables override this file.

# Model provider: set at least one key. If both are set, Anthropic is used unless MODEL_PROVIDER says otherwise.
# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini key (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web search (required). Free credits on signup: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# Optional: force a provider, "anthropic" or "gemini".
MODEL_PROVIDER=
# Optional: override the chat model. Defaults: claude-opus-5-5 (Anthropic), gemini-3.8-flash (Gemini).
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Optional: pretend "now" is this ISO time, e.g. 2026-11-10T12:00:00. Used for demos of "last Tuesday".
AGENT_NOW=

# Optional: HTTP port (default 3000).
PORT=3000

# Optional, eval only: grade answers with a different Gemini model than the one answering.
EVAL_JUDGE_MODEL=
